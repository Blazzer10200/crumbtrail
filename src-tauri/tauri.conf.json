{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Crumbtrail",
  "version": "0.4.0",
  "identifier": "com.blazzer.crumbtrail",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Crumbtrail",
        "width": 920,
        "height": 700,
        "minWidth": 760,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Blazzer10200/crumbtrail/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUxQjJFQjY1NUE2MThBRkEKUldUNmltRmFaZXV5NFlMZjFkdGVhNHJKY2lONzVXbHpZc0NSYVcxa0g3K0htRFI3TVhSN3RIbEcK"
    }
  }
}
